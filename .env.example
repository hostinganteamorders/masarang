# Salin berkas ini menjadi .env.local (lokal) atau isi di pengaturan hosting.

# Alamat publik situs, tanpa garis miring di akhir. Dipakai untuk canonical, hreflang,
# sitemap.xml, dan robots.txt. Ganti dengan domain yang sebenarnya.
NEXT_PUBLIC_SITE_URL=https://masarangfoundation.org

# --- Admin (/admin) ---
# Akun pemilik. Sandi dipakai untuk masuk; simpan di pengelola sandi, jangan dibagikan lewat chat.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Acak, minimal 16 karakter. Dipakai menandatangani penanda masuk.
ADMIN_SECRET=
# Terisi otomatis oleh Vercel setelah Upstash Redis dan Blob dihubungkan (Storage):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# Hook pembangunan ulang (Settings > Git > Deploy Hooks). Dipicu tombol Terbitkan.
# VERCEL_DEPLOY_HOOK_URL=
